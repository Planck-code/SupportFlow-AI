# Set in PowerShell with: $env:PORT = '8080'
# The application does not automatically load .env files.
PORT=8080

# Compose reads .env; Go processes read environment variables only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=supportflow
DB_PASSWORD=
DB_NAME=supportflow
DB_TIMEOUT=3s
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Used by Docker Compose only. Choose a separate local password.
MYSQL_ROOT_PASSWORD=

# Only used by explicit integration tests; must be empty and end in _test.
TEST_DATABASE_NAME=supportflow_m2_test
