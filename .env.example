# Host HTTP port (Compose publishes 127.0.0.1:PORT -> api:8080).
# The application does not automatically load .env files.
PORT=8080

# API only: use a locally generated random secret of at least 32 bytes.
# Never commit the real value. Access tokens expire after 2 hours.
JWT_SECRET=

# Optional, API only. Explicit model client initialization requires all three.
# Supply the provider's base path, including /v1 if needed.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20s

# Compose reads .env; Go processes read environment variables only.
DB_HOST=127.0.0.1
# Published MySQL host port. API and tools containers always use mysql:3306.
DB_PORT=3306
DB_USER=supportflow
DB_PASSWORD=
DB_NAME=supportflow
DB_TIMEOUT=3s
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Used by Docker Compose only. Choose a separate local password.
MYSQL_ROOT_PASSWORD=

# Only used by explicit integration tests; must be empty and end in _test.
TEST_DATABASE_NAME=supportflow_m2_test
