# Allow only build inputs. Local env files, secrets, VCS data, binaries,
# caches, logs, editor/debug files and acceptance artifacts stay outside.
**
!go.mod
!go.sum
!cmd/
!cmd/**/
!cmd/**/*.go
!internal/
!internal/**/
!internal/**/*.go
**/*_test.go
!migrations/
!migrations/*.sql
**/secrets/**
**/.git/**
**/.env*
**/__debug_bin*
